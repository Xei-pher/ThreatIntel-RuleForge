# Optional OpenAI integration. Leave blank to use deterministic fallbacks only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_REPORT_CHARS=60000
LLM_DEBUG=false

# Optional VirusTotal enrichment for public IPv4 indicators.
VIRUSTOTAL_API_KEY=
VT_TIMEOUT_SECONDS=20

# Judge layer. Requires OPENAI_API_KEY when enabled.
JUDGE_ENABLED=true
JUDGE_ACCEPT_SCORE=70
JUDGE_REVIEW_SCORE=50

# Runtime
LOG_LEVEL=INFO
MAX_UPLOAD_MB=25
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional comma-separated IOC quality controls.
IOC_DOMAIN_DENYLIST=dfirreport.com,www.dfirreport.com,thedfirreport.com,www.thedfirreport.com,attack.mitre.org,mitre.org,virustotal.com,www.virustotal.com,github.com,raw.githubusercontent.com
IOC_DOMAIN_ALLOWLIST=
